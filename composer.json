{
	"name": "nette/nette",
	"type": "library",
	"description": "👪 Nette Framework - innovative framework for fast and easy development of secured web applications in PHP (metapackage)",
	"keywords": ["framework", "mvc", "metapackage"],
	"homepage": "https://nette.org",
	"license": ["BSD-3-Clause", "GPL-2.0-only", "GPL-3.0-only"],
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		},
		{
			"name": "Nette Community",
			"homepage": "https://nette.org/contributors"
		}
	],
	"require": {
		"nette/application": ">=3.3",
		"nette/assets": ">=1.0",
		"nette/bootstrap": ">=3.3",
		"nette/caching": ">=3.4",
		"nette/command-line": ">=1.0",
		"nette/database": ">=3.2",
		"nette/di": ">=3.2",
		"nette/forms": ">=3.3",
		"nette/http": ">=3.4",
		"nette/mail": ">=4.2",
		"nette/php-generator": ">=4.2",
		"nette/robot-loader": ">=4.1",
		"nette/safe-stream": ">=3.0",
		"nette/security": ">=3.2",
		"nette/utils": ">=4.1",
		"latte/latte": ">=3.1",
		"tracy/tracy": ">=2.12"
	},
	"require-dev": {
		"nette/tester": ">=2.6"
	},
	"autoload": {
		"classmap": ["Nette/"]
	},
	"extra": {
		"branch-alias": {
			"dev-master": "3.2-dev"
		}
	}
}
